{
  "name": "sistema-calzado",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,realtime",
    "db:reset": "supabase db reset",
    "db:tipos": "supabase gen types typescript --local > lib/database.types.ts",
    "db:test": "supabase test db",
    "db:stop": "supabase stop",
    "revisar": "tsc --noEmit && eslint && npm run test:unidades && next build",
    "instalaciones": "node scripts/instalaciones.mjs",
    "test:unidades": "NODE_NO_WARNINGS=1 node --test lib/*.test.ts lib/*/*.test.ts scripts/*.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.1.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^20",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
