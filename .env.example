# Copiá este archivo como .env.local y completalo con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API Keys). En Vercel se cargan en Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# WhatsApp (Meta) y la IA (Gemini) NO van acá: se configuran en el panel (Tienda online → Conexiones)
# y las claves quedan guardadas en la base, sin que nadie las pueda leer.
