# Copiá este archivo como .env.local y completalo con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API Keys). En Vercel se cargan en Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Integración con Meta WhatsApp Cloud API (solo servidor)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0

# Google AI Studio (solo servidor)
GEMINI_API_KEY=
